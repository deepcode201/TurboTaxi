FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Solution varsa mütləq əlavə et
COPY *.sln .

COPY TurboTaxi.API/TurboTaxi.API.csproj TurboTaxi.API/
COPY TurboTaxi.Application/TurboTaxi.Application.csproj TurboTaxi.Application/
COPY TurboTaxi.Domain/TurboTaxi.Domain.csproj TurboTaxi.Domain/
COPY TurboTaxi.Infrastructure/TurboTaxi.Infrastructure.csproj TurboTaxi.Infrastructure/
COPY TurboTaxi.Models/TurboTaxi.Models.csproj TurboTaxi.Models/
COPY TurboTaxi.Realtime/TurboTaxi.Realtime.csproj TurboTaxi.Realtime/

RUN dotnet restore

COPY . .

RUN dotnet build TurboTaxi.API/TurboTaxi.API.csproj -c Release --no-restore
RUN dotnet publish TurboTaxi.API/TurboTaxi.API.csproj -c Release -o /app/publish --no-build /p:UseAppHost=false

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
ENV ASPNETCORE_URLS=http://0.0.0.0:8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "TurboTaxi.API.dll"]
